{
  "kind": "collectionType",
  "collectionName": "blog_posts",
  "info": {
    "singularName": "blog-post",
    "pluralName": "blog-posts",
    "displayName": "Blog Article"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "slug": {
      "type": "string",
      "unique": true
    },
    "title": {
      "type": "text"
    },
    "excerpt": {
      "type": "text"
    },
    "date": {
      "type": "string"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "videos"
      ],
      "required": true
    },
    "number": {
      "type": "string"
    },
    "body": {
      "type": "text"
    },
    "author": {
      "type": "string"
    },
    "publishedDate": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
