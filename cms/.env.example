# Copy to cms/.env for local development (without Docker).
# Generate each secret with:  openssl rand -base64 16

HOST=0.0.0.0
PORT=1337
# Public URL when running behind a proxy/host, e.g. https://cms.340consultancy.com
PUBLIC_URL=

# Public URL of the WEBSITE, e.g. https://340consultancy.com — used by the
# "open on website" preview buttons in the admin (default: http://localhost:8080)
CLIENT_URL=

APP_KEYS=key1,key2,key3,key4
API_TOKEN_SALT=changeme
ADMIN_JWT_SECRET=changeme
TRANSFER_TOKEN_SALT=changeme
JWT_SECRET=changeme
ENCRYPTION_KEY=changeme

# sqlite (default, zero-config) or postgres (used by docker-compose)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# Postgres settings (only when DATABASE_CLIENT=postgres)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=strapi
DATABASE_SSL=false

# Comma-separated list of allowed frontend origins (default: all)
CORS_ORIGINS=

# Set to false to skip pre-filling an empty CMS from data/seed.json
SEED_FROM_DEFAULTS=true

# Set to false to stop re-applying the editor-friendly admin field labels /
# hidden technical fields on every start (src/content-manager-config.js) —
# e.g. if you want to customize the Content-Manager views by hand.
CMS_APPLY_ADMIN_LABELS=true

# Signs the short-lived tokens behind the admin "Open preview" DRAFT view.
# Optional — without it the preview always shows the published state.
PREVIEW_SECRET=
