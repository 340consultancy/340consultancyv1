# Environment for docker-compose (Strapi CMS + Postgres).
# Copy to .env.docker and fill in — generate each secret with:
#   openssl rand -base64 16
# APP_KEYS needs four comma-separated values:
#   echo "$(openssl rand -base64 16),$(openssl rand -base64 16),$(openssl rand -base64 16),$(openssl rand -base64 16)"

DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=

APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# Public URL of the CMS once it has a domain, e.g. https://cms.340consultancy.com
PUBLIC_URL=

# Public URL of the WEBSITE (Vercel), e.g. https://340consultancy.com — used by
# the "open on website" preview buttons in the admin
CLIENT_URL=

# Comma-separated frontend origins allowed via CORS (empty = allow all)
CORS_ORIGINS=

# Signs the short-lived tokens behind the admin "Open preview" DRAFT view
# (openssl rand -base64 16). Optional — without it the preview always shows
# the published state.
PREVIEW_SECRET=

# Pre-fill an empty CMS with the site's bundled text content on first start
SEED_FROM_DEFAULTS=true

# Set to false to stop re-applying the editor-friendly admin field labels on
# every start (see cms/src/content-manager-config.js)
CMS_APPLY_ADMIN_LABELS=true
